# Supabase (required for local dev and Netlify builds)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostgreSQL schema inside the project (default: public)
VITE_SUPABASE_SCHEMA=public

# Dev-only: auto-fill Staff Portal login (npm run dev only; ignored in production builds)
VITE_DEMO_USERNAME=pos_demo_account
VITE_DEMO_PASSWORD=pos_demo_account

# --- Netlify (set in Site configuration → Environment variables, not in .env.local) ---
# Staging site — scope "Deploy Previews" + "Branch deploys" + "Production" to STAGING Supabase:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# Production site — scope "Production" only to PRODUCTION Supabase.
# See docs/NETLIFY_DEPLOY_PREVIEWS.md
